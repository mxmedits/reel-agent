# Copy to .env and fill in. Never share this file.

# AI brain: set ONE of these (or none for template-only mode)
# Claude (paid per use, best quality): console.anthropic.com
ANTHROPIC_API_KEY=
# Google Gemini (free tier, rate-limited): aistudio.google.com → Get API key
GEMINI_API_KEY=

# Free trend data: this week's top gaming Shorts (console.cloud.google.com → enable "YouTube Data API v3" → API key)
YOUTUBE_API_KEY=

# Filled in automatically by:  python -m reelagent setup-instagram
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_USERNAME=

# Optional premium voices (set voiceover.engine in config.yaml)
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
